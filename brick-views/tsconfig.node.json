{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    // DOM is here for the Web-standard Request/Response the api/ handlers are
    // written against, not for browser code — nothing in this project runs in
    // both places.
    "lib": ["ES2023", "DOM"],
    // vite/client is needed because scripts/ transitively imports src/core,
    // which uses import.meta.glob to load the bundled puzzle JSON.
    "types": ["node", "vite/client"],
    "skipLibCheck": true,

    /* Bundler mode — api/ is bundled by Vercel and scripts run through tsx,
       so neither resolves imports by Node's ESM extension rules. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // Everything that runs in Node rather than the browser. api/ and src/db were
  // previously in no project at all, so `npm run build` typechecked none of the
  // backend — a broken handler could pass a green build.
  "include": ["vite.config.ts", "drizzle.config.ts", "api", "scripts", "src/db"]
}
